<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 (analyzer release tracking) does not apply to source generators that are versioned with the repo. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MyAgents.Generators</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Ship as a Roslyn source-generator analyzer package: the generator DLL goes into
    analyzers/dotnet/cs and is picked up automatically by consumers who reference this
    package, enabling [AgentTool] code generation without a ProjectReference.
  -->
  <PropertyGroup>
    <DevelopmentDependency>false</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- No lib assembly or PDBs by design, so there is nothing for a symbol package; also
         NU5128/NU5017 are expected for analyzer-only packages. -->
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128;NU5017</NoWarn>
    <Description>MyAgents source generator: compile-time [AgentTool] ITool wrappers with JSON schema generation, reflection-free argument binding, and NativeAOT-safe JsonContext serialization.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
